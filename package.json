{
  "name": "joplin-plugin-theme-studio",
  "version": "1.1.0",
  "description": "All-in-one multi-palette engine with native RTL/LTR typography for Joplin",
  "main": "dist/index.js",
  "files": [
    "publish"
  ],
  "scripts": {
    "dist": "webpack --env joplin-plugin-config=buildMain && webpack --env joplin-plugin-config=buildExtraScripts && webpack --env joplin-plugin-config=createArchive",
    "build": "webpack --env joplin-plugin-config=buildMain && webpack --env joplin-plugin-config=buildExtraScripts"
  },
  "keywords": [
    "joplin-plugin",
    "theme",
    "dark-theme",
    "light-theme",
    "palette",
    "rtl",
    "ltr",
    "vazirmatn",
    "persian",
    "arabic",
    "tokyo-night",
    "everforest",
    "catppuccin",
    "nord",
    "dracula",
    "gruvbox",
    "atom-one",
    "mermaid"
  ],
  "author": "Yashar",
  "license": "MIT",
  "devDependencies": {
    "copy-webpack-plugin": "^14.0.0",
    "fs-extra": "^11.4.1",
    "glob": "^13.0.6",
    "tar": "^7.5.22",
    "ts-loader": "^9.6.2",
    "typescript": "^5.8.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  }
}
