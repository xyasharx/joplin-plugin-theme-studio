{
  "compilerOptions": {
    "target": "ES2020",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "api": ["./api/index"],
      "api/*": ["./api/*"]
    },
    "noEmit": true
  },
  "include": ["src/**/*", "api/**/*"]
}
