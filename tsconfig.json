{
  "compilerOptions": {
    "target": "ES2018",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "api": ["api/index"],
      "api/*": ["api/*"]
    },
    "outDir": "./dist"
  },
  "include": [
    "src/**/*",
    "api/**/*"
  ]
}
